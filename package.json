{
  "name": "nobar",
  "private": true,
  "description": "Nobar (نوبر) — multi-vendor fruit & vegetable marketplace with an AI shopping assistant",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deck": "pnpm --filter @nobar/seminar-deck build",
    "dev:web": "pnpm --filter @nobar/web dev",
    "dev:seller": "pnpm --filter @nobar/seller dev",
    "dev:admin": "pnpm --filter @nobar/admin dev",
    "dev:api": "pnpm --filter @nobar/api dev",
    "typecheck:frontends": "pnpm --filter @nobar/web --filter @nobar/seller --filter @nobar/admin typecheck",
    "lint:rtl": "node tools/check-rtl/check-rtl.mjs",
    "test": "pnpm --filter @nobar/fa --filter @nobar/demo --filter @nobar/api test",
    "typecheck": "pnpm --filter @nobar/common --filter @nobar/contracts --filter @nobar/demo --filter @nobar/api typecheck && pnpm typecheck:frontends"
  }
}
