# Edge: Caddy (automatic HTTPS) serving the seller and admin panels as static files and proxying the store
# and the API. Build from the repository root:  docker build -f infra/compose/Dockerfile.edge -t nobar-edge .
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
ENV NEXT_EXPORT=1 NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_API_URL=/ NEXT_PUBLIC_STORE_URL=/
COPY . .
RUN pnpm install --frozen-lockfile --filter @nobar/seller... --filter @nobar/admin... \
 && NEXT_PUBLIC_BASE_PATH=/seller pnpm --filter @nobar/seller build \
 && NEXT_PUBLIC_BASE_PATH=/admin pnpm --filter @nobar/admin build \
 && mkdir -p /site \
 && cp -r apps/seller/out /site/seller \
 && cp -r apps/admin/out /site/admin \
 && node tools/static-export/flatten-segments.mjs /site

FROM caddy:2.10-alpine
# run as an unprivileged user that may still bind ports 80 and 443
RUN apk add --no-cache libcap \
 && setcap cap_net_bind_service=+ep /usr/bin/caddy \
 && adduser -D -H -u 10001 edge \
 && mkdir -p /data /config \
 && chown -R edge /data /config
COPY --from=build /site /srv
COPY infra/compose/Caddyfile /etc/caddy/Caddyfile
USER edge
