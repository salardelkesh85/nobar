# Copy to .env (never commit it). Then add the secrets once:
#   docker compose run --rm --no-deps api node dist/keygen.js >> .env

# --- site
# your domain: Caddy gets the HTTPS certificate for it (DNS must point here, ports 80/443 open)
SITE_ADDRESS=nobar.example
PUBLIC_URL=https://nobar.example

# --- database
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14

# --- staff: phones that get the ADMIN role when they sign in (comma separated)
ADMIN_PHONES=09120000000

# --- payment gateway (ZarinPal)
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=

# --- SMS (Melipayamak)
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
# MELIPAYAMAK_OTP_BODY_ID=

# --- assistant: "fake" answers with fixed rules (no model); see docs/ai-architecture.md
LLM_PROVIDER=fake
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://your-model-server:8000/v1
# LLM_MODEL=
# LLM_API_KEY=

# --- optional
# SEED_DEMO=false
# RATE_LIMIT_PER_MIN=600
# AI_DAILY_MESSAGES=40
