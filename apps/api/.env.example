# Local development settings for `pnpm dev:api` (copy to .env; .env is not committed).
# Everything has a safe development default; see README.md for the full list.
PORT=4000
LOG_FORMAT=pretty
# phones that get the ADMIN role when they sign in (admin panel)
ADMIN_PHONES=09140000000
# OTP_ECHO=true
# DATABASE_URL=postgres://nobar:nobar@localhost:5432/nobar

# --- real providers (leave unset in development: codes are logged, payments use the test gateway) ---
# SMS_PROVIDER=melipayamak
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# MELIPAYAMAK_FROM=
# MELIPAYAMAK_OTP_BODY_ID=
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true
